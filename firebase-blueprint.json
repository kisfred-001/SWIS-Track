{
  "entities": {
    "Campus": {
      "collection": "campuses",
      "fields": {
        "id": { "type": "string", "description": "Unique campus ID (e.g. spring-campus, hope-campus)" },
        "name": { "type": "string", "description": "Campus name: Spring Campus or Hope Campus" },
        "code": { "type": "string", "description": "Campus code: SPRING or HOPE" },
        "lead_administrator": { "type": "string", "description": "Primary campus administrator name" },
        "location": { "type": "string", "description": "Physical address / campus location" },
        "phone": { "type": "string", "description": "Campus contact telephone" },
        "email": { "type": "string", "description": "Campus official email" },
        "opening_time": { "type": "string", "description": "Standard gates open time (e.g. 07:30 AM)" },
        "closing_time": { "type": "string", "description": "Standard gates close time (e.g. 04:30 PM)" },
        "capacity": { "type": "number", "description": "Max student capacity" }
      }
    },
    "LearningCenter": {
      "collection": "learning_centers",
      "fields": {
        "id": { "type": "string", "description": "Unique learning center identifier" },
        "name": { "type": "string", "description": "Learning center name" },
        "campus": { "type": "string", "description": "Associated campus (Spring Campus or Hope Campus)" },
        "supervisor_name": { "type": "string", "description": "Assigned class supervisor" },
        "monitor_name": { "type": "string", "description": "Assigned class monitor (equal rights as supervisor)" },
        "room_number": { "type": "string", "description": "Room or wing identifier" },
        "capacity": { "type": "number", "description": "Room capacity" },
        "description": { "type": "string", "description": "Grade / stage description" }
      }
    },
    "Staff": {
      "collection": "staff",
      "fields": {
        "staff_id": { "type": "string", "description": "Unique staff identifier (e.g. STF-001)" },
        "pin_code": { "type": "string", "description": "Unique 3-digit code" },
        "full_name": { "type": "string", "description": "Staff full name" },
        "role": { "type": "string", "description": "ICCE Coordinator, Principal, Director, Administrator, Administrative Assistant, Supervisor, Monitor, Support Staff" },
        "campus": { "type": "string", "description": "Spring Campus, Hope Campus, or All Campuses" },
        "learning_center_id": { "type": "string", "description": "Assigned learning center" },
        "email": { "type": "string", "description": "Institutional email address" },
        "phone": { "type": "string", "description": "Contact telephone" },
        "qr_code_url": { "type": "string", "description": "QR code token / payload" },
        "created_at": { "type": "string", "description": "Creation timestamp" }
      }
    },
    "Student": {
      "collection": "students",
      "fields": {
        "student_id": { "type": "string", "description": "Unique student identifier (e.g. STU-1001)" },
        "pin_code": { "type": "string", "description": "Unique 4-digit code" },
        "full_name": { "type": "string", "description": "Student full name from official roster" },
        "grade": { "type": "string", "description": "Grade level / Class" },
        "campus": { "type": "string", "description": "Campus: Spring Campus or Hope Campus" },
        "learning_center_id": { "type": "string", "description": "Assigned Learning Center" },
        "supervisor_name": { "type": "string", "description": "Main supervisor name" },
        "monitor_name": { "type": "string", "description": "Assigned monitor name" },
        "qr_code_url": { "type": "string", "description": "QR code token / payload" },
        "parent_names": { "type": "string", "description": "Parent or guardian names" },
        "emergency_contact": { "type": "string", "description": "Emergency contact number" },
        "created_at": { "type": "string", "description": "Creation timestamp" }
      }
    },
    "AttendanceLog": {
      "collection": "attendance_logs",
      "fields": {
        "log_id": { "type": "string", "description": "Unique log document ID" },
        "target_type": { "type": "string", "description": "Student or Teacher" },
        "target_id": { "type": "string", "description": "student_id or staff_id" },
        "target_name": { "type": "string", "description": "Name of student or teacher" },
        "campus": { "type": "string", "description": "Spring Campus or Hope Campus" },
        "date": { "type": "string", "description": "Date formatted YYYY-MM-DD" },
        "check_in_time": { "type": "string", "description": "Timestamp or HH:mm string of check in" },
        "check_out_time": { "type": "string", "description": "Timestamp or HH:mm string of check out, or null" },
        "scanned_by": { "type": "string", "description": "Staff ID and name of operator" },
        "pickup_dropoff_party": { "type": "object", "description": "Parent vs Designate details" },
        "early_departure_reason": { "type": "string", "description": "Reason for early departure" },
        "status": { "type": "string", "description": "Active, Pending Edit Approval, Edited, or Deleted" },
        "classroom": { "type": "string", "description": "Learning center or classroom" }
      }
    },
    "EditRequest": {
      "collection": "edit_requests",
      "fields": {
        "request_id": { "type": "string", "description": "Unique edit request ID" },
        "log_id": { "type": "string", "description": "Reference to attendance log ID" },
        "requested_by": { "type": "string", "description": "Staff ID and name" },
        "original_data": { "type": "object", "description": "Snapshot of previous log state" },
        "proposed_data": { "type": "object", "description": "Proposed changes" },
        "reason_for_edit": { "type": "string", "description": "Justification from requester" },
        "is_urgent": { "type": "boolean", "description": "Whether an urgent alert was triggered" },
        "status": { "type": "string", "description": "Pending, Approved, Rejected" },
        "reviewed_by": { "type": "string", "description": "Admin staff ID who reviewed" },
        "review_comment": { "type": "string", "description": "Mandatory approval reason / feedback" }
      }
    },
    "UrgentAlert": {
      "collection": "urgent_alerts",
      "fields": {
        "id": { "type": "string", "description": "Unique alert identifier" },
        "request_id": { "type": "string", "description": "Reference to Edit Request ID" },
        "log_id": { "type": "string", "description": "Reference to attendance log ID" },
        "target_name": { "type": "string", "description": "Name of student or teacher" },
        "target_type": { "type": "string", "description": "Student or Teacher" },
        "teacher_name": { "type": "string", "description": "Name of requester" },
        "teacher_role": { "type": "string", "description": "Role of requester" },
        "reason": { "type": "string", "description": "Reason for urgent edit request" },
        "timestamp": { "type": "string", "description": "ISO timestamp of dispatch" },
        "dismissed_by": { "type": "array", "description": "Array of staff IDs who dismissed the alert banner" }
      }
    }
  }
}
